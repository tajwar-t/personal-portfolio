{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{ "slug": "bg", "name": "Background", "color": "#f2efe7" },
				{ "slug": "bg-alt", "name": "Background Alt", "color": "#eae5da" },
				{ "slug": "bg-elevated", "name": "Background Elevated", "color": "#faf8f3" },
				{ "slug": "text", "name": "Text", "color": "#16140f" },
				{ "slug": "text-muted", "name": "Text Muted", "color": "#5c5849" },
				{ "slug": "text-faint", "name": "Text Faint", "color": "#8c8672" },
				{ "slug": "accent", "name": "Terracotta Accent", "color": "#e8492f" },
				{ "slug": "accent-2", "name": "Accent Light", "color": "#ff8a5c" },
				{ "slug": "accent-3", "name": "Accent Gold", "color": "#c9a44c" }
			]
		},
		"typography": {
			"writingMode": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Archivo",
					"fontFamily": "\"Archivo\", \"Space Grotesk\", \"Inter\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontWeight": "600 900",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./assets/fonts/archivo.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "\"Inter\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./assets/fonts/inter.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./assets/fonts/jetbrains-mono.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.05rem" },
				{ "slug": "large", "name": "Large", "size": "1.4rem" },
				{ "slug": "x-large", "name": "X-Large", "size": "2.25rem" },
				{ "slug": "xx-large", "name": "XX-Large", "size": "clamp(2.8rem, 9vw, 6.5rem)" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "Tiny", "size": "0.5rem" },
				{ "slug": "30", "name": "Small", "size": "1rem" },
				{ "slug": "40", "name": "Medium", "size": "1.5rem" },
				{ "slug": "50", "name": "Large", "size": "2.5rem" },
				{ "slug": "60", "name": "X-Large", "size": "4rem" },
				{ "slug": "70", "name": "XX-Large", "size": "7rem" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1220px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "800",
					"letterSpacing": "-0.02em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
